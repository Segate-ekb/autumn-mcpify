// Тест-страж канала stdio: stdout MCP-сервера - это поток JSON-RPC, любая посторонняя строка
// (лог фреймворка, предупреждение об устаревшем методе зависимости) ломает протокол у клиента.
//
// Сервер запускается отдельным процессом из временного каталога: точка входа подключает
// исходники библиотеки по абсолютному пути, зависимости берутся из oscript_modules репозитория
// через oscript.cfg рядом с точкой входа.

#Использовать asserts

&Тест
Процедура ТестДолжен_ПисатьВПотокВыводаТолькоСообщенияПротокола() Экспорт

	КаталогПриложения = СоздатьПриложение();
	Попытка
		Вывод = ВыполнитьЗапросИнициализации(КаталогПриложения);
	Исключение
		УдалитьФайлы(КаталогПриложения);
		ВызватьИсключение;
	КонецПопытки;
	УдалитьФайлы(КаталогПриложения);

	Строки = НепустыеСтроки(Вывод);
	Ожидаем.Что(Строки.Количество(), "сервер должен ответить на initialize").Больше(0);
	Для Каждого Строка Из Строки Цикл
		Ожидаем.Что(СтрНачинаетсяС(Строка, "{"), "посторонняя строка в stdout: " + Строка).ЕстьИстина();
	КонецЦикла;
	Ожидаем.Что(Вывод).Содержит("""protocolVersion""");

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

// Минимальное приложение без команд: точка входа MCP и настройка путей библиотек.
// autumn-logos подключён, как у реального потребителя: без него секция logos из деталек
// не применяется и лог фреймворка идёт в консоль мимо MCP-аппендера.
//
// Возвращаемое значение:
//   Строка - каталог приложения
//
Функция СоздатьПриложение()

	КорневойКаталог = Новый Файл(ОбъединитьПути(Новый Файл(ТекущийСценарий().Источник).Путь, "..")).ПолноеИмя;

	Каталог = ПолучитьИмяВременногоФайла();
	СоздатьКаталог(Каталог);

	КаталогИсходников = СтрЗаменить(ОбъединитьПути(КорневойКаталог, "src"), "\", "/");
	ЗаписатьФайл(ОбъединитьПути(Каталог, "mcp.os"),
		"#Использовать autumn
		|#Использовать autumn-logos
		|#Использовать """ + КаталогИсходников + """
		|Запуск = Новый MCP_Запуск();
		|Запуск.Старт();
		|");
	ЗаписатьФайл(ОбъединитьПути(Каталог, "oscript.cfg"),
		"lib.additional=" + ОбъединитьПути(КорневойКаталог, "oscript_modules") + Символы.ПС);

	Возврат Каталог;

КонецФункции

// Параметры:
//   КаталогПриложения - Строка - каталог с точкой входа mcp.os
//
// Возвращаемое значение:
//   Строка - весь stdout сервера
//
Функция ВыполнитьЗапросИнициализации(Знач КаталогПриложения)

	Запрос = "{""jsonrpc"":""2.0"",""id"":1,""method"":""initialize"",""params"":{""protocolVersion"":""2024-11-05"","
		+ """capabilities"":{},""clientInfo"":{""name"":""test"",""version"":""1""}}}";

	СтрокаЗапуска = "oscript """ + ОбъединитьПути(КаталогПриложения, "mcp.os") + """";
	Процесс = СоздатьПроцесс(СтрокаЗапуска, КаталогПриложения, Истина, Истина);
	Процесс.Запустить();

	// Закрытый ввод завершает цикл сервера после ответа на запрос
	Процесс.ПотокВвода.ЗаписатьСтроку(Запрос);
	Процесс.ПотокВвода.Закрыть();

	// Читать после завершения: до него Прочитать() отдаёт только уже накопленное (пусто)
	Процесс.ОжидатьЗавершения();

	Возврат Процесс.ПотокВывода.Прочитать();

КонецФункции

Функция НепустыеСтроки(Знач Текст)

	Результат = Новый Массив;
	Для Каждого Строка Из СтрРазделить(СтрЗаменить(Текст, Символы.ВК, ""), Символы.ПС, Ложь) Цикл
		Если НЕ ПустаяСтрока(Строка) Тогда
			Результат.Добавить(СокрЛП(Строка));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ЗаписатьФайл(Знач ПутьКФайлу, Знач Текст)
	Запись = Новый ЗаписьТекста(ПутьКФайлу, КодировкаТекста.UTF8NoBOM);
	Запись.Записать(Текст);
	Запись.Закрыть();
КонецПроцедуры

#КонецОбласти
